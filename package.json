{
  "name": "uptime-monitoring",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @uptime/server dev",
    "test": "pnpm -r build && pnpm -r test",
    "test:e2e": "pnpm -r build && pnpm --filter @uptime/e2e test:e2e",
    "coverage": "pnpm -r build && pnpm -r coverage",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "openapi-bootstrap": "node scripts/openapi-bootstrap.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.43.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "body-parser": "2.4.0",
      "tinypool": "2.1.2",
      "esbuild@~0.18.20": "0.25.12",
      "glob@^13.0.6": "14.0.2",
      "minimatch@^10.2.2": "11.0.1",
      "minimatch@~10.2.4": "11.0.1",
      "qs": "6.16.1"
    }
  }
}