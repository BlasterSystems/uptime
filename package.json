{
  "name": "uptime-monitoring",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @uptime/server dev",
    "test": "pnpm -r build && pnpm -r test",
    "test:e2e": "pnpm -r build && pnpm --filter @uptime/e2e test:e2e",
    "coverage": "pnpm -r build && pnpm -r coverage",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "openapi-bootstrap": "node scripts/openapi-bootstrap.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "body-parser": "2.4.0",
      "tinypool": "2.1.2"
    }
  }
}
