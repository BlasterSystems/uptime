# Copy to deploy/.env on the docker VM (/opt/uptime-monitor/deploy/.env).
# CI never rewrites this file; edits require `docker compose restart uptime`.
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
PORT=3101
SEED=0
ENCRYPTION_KEY=replace-me-openssl-rand-hex-32
UPTIME_AGENT_TOKEN=
# GID of the host's `docker` group so the container may read the mounted
# socket; check with: stat -c %g /var/run/docker.sock
DOCKER_GID=999
