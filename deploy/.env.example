# .env for the docker VM (/opt/uptime-monitor/deploy/.env).
# CI never rewrites this file; edits require `docker compose restart uptime`.
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
PORT=3101
SEED=0
ENCRYPTION_KEY=replace-me-openssl-rand-hex-32
UPTIME_AGENT_TOKEN=
# Raw-heartbeat retention (SPEC §4): beats older than RETENTION_DAYS are
# pruned daily by the server (180-day default). Set RETENTION_DISABLE=1 to opt out.
RETENTION_DAYS=180
# RETENTION_DISABLE=1
# Express `trust proxy` when the container sits behind a reverse proxy (NPM,
# Caddy, Traefik, nginx): `1` trusts one hop, so req.ip (per-IP rate limits)
# and req.secure (Secure cookies) come from X-Forwarded-*. Leave unset when
# the port is exposed directly.
# TRUST_PROXY=1
# GID of the host's `docker` group so the container may read the mounted
# socket; check with: stat -c %g /var/run/docker.sock
DOCKER_GID=999
