    "@uptime/notify": "workspace:*",
    "express": "^5.1.0",
    "prom-client": "^15.1.3",
    "croner": "^10.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "vitest": "^4.1.11"
  }
