{
  "name": "@uptime/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --watch dist/main.js",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
